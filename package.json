{
  "name": "matching-server-shogi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "dev:ws": "bun run src/dev/server.ts",
    "build:lambda": "bash scripts/build-lambda-zip.sh",
    "smoke:match": "bun run scripts/dev-match-smoke.ts",
    "smoke:concurrent": "bun run scripts/concurrent-match-smoke.ts",
    "smoke:stack": "bun run scripts/local-stack-smoke.ts",
    "tf:sync-env": "bun run scripts/sync-terraform-env.ts",
    "test": "bun test",
    "test:unit": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1073.0",
    "@aws-sdk/client-dynamodb": "^3.1073.0",
    "@aws-sdk/client-sqs": "^3.1073.0",
    "@aws-sdk/lib-dynamodb": "^3.1073.0"
  }
