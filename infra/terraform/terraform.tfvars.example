name_prefix = "matching-server-shogi-dev"
aws_region  = "ap-northeast-1"

# Build artifact produced by your Lambda bundling step.
lambda_zip_path = "../../dist/lambda.zip"
lambda_runtime  = "nodejs22.x"
lambda_handler  = "index.handler"

stage_name = "dev"

# These values are generated from ../bff.shogi/.env into bff.auto.tfvars:
# - bff_base_url
# - matching_bff_internal_token
# - matching_ticket_secret
#
# Generate them with:
#   bun run tf:sync-env

matchmaking_batch_size                     = 20
matchmaking_bucket_scan_limit              = 50
matchmaking_bucket_candidate_limit         = 25
matchmaking_sqs_batch_size                 = 10
matchmaking_worker_max_concurrency         = 2
matchmaking_queue_visibility_timeout_seconds = 180
