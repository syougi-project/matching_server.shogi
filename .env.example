# Shared with bff.shogi runtime
# MATCHING_BFF_BASE_URL=
# MATCHING_BFF_INTERNAL_TOKEN=
# MATCHING_TICKET_SECRET=

# GitHub Actions repository secret for the dev matching server
# TF_VAR_dev_bff_base_url=https://your-dev-bff.execute-api.ap-northeast-1.amazonaws.com

# Optional local-only overrides
# PORT=3010
# MATCHING_BFF_BASE_URL=http://localhost:3000
# MATCHING_BFF_INTERNAL_TOKEN=
# MATCHING_TICKET_SECRET=
# 1台だけ CPU と対戦したいときのみ true（インターネット対戦の人間マッチングでは false）
# MATCHING_DEV_AUTO_BOT=false
# MATCHING_RATING_BUCKET_SIZE=100
# MATCHING_RECONNECT_GRACE_SECONDS=30
# MATCHING_QUEUE_TTL_SECONDS=120
